{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/usados", "dest": "/usados.html" },
    { "src": "/nuevos", "dest": "/nuevos.html" },
    { "src": "/reventas", "dest": "/index.html" },
    { "src": "/", "dest": "/home.html" },
    { "src": "/(.*)", "dest": "/home.html" }
  ]
}
